# APPLICATION PROPERTIES
NODE_ENV=development
API_PORT=3000
TIMEOUT=12000

# CORS
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:8080,http://localhost:80
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Origin,X-Requested-With,Accept,Access-Control-Allow-Origin
CORS_EXPOSED_HEADERS=Content-Type,Authorization,Origin,X-Requested-With,Accept,Access-Control-Allow-Origin
CORS_CREDENTIALS=true

# DATABASE PROPERTIES
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_template

# CACHE REDIS
CACHE_HOST=redis
CACHE_PORT=6379
CACHE_PASSWORD=myStrongPassword

# AUTH
JWT_SECRET=change-me-in-a-real-environment
